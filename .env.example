# Copy to .env and fill in. Keys come from https://web3.binance.com/en/dev-portal
BINANCE_W3_API_KEY=
BINANCE_W3_API_SECRET=

# Optional. A bot token from @BotFather turns on the Telegram bot.
TELEGRAM_BOT_TOKEN=
# Optional. The receiving address set during B402 onboarding turns on the paid /x402 routes.
# The API key above must have the B402 Payments permission.
B402_PAY_TO=
# Optional. The public address of this server, used for links the bot and paid API hand out.
PUBLIC_URL=
